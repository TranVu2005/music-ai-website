{
  "name": "music-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "check:audio": "sh tools/check-audio.sh",
    "tools:preview-gen": "tsx tools/generate-preview.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "prisma": {
    "schema": "src/db/schema.prisma",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
