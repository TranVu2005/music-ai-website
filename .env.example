# ==========================================
# Cấu hình Môi trường music-shop theo [STACK]
# ==========================================

# Server & App Config
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/music_shop_db?schema=public"

# Object Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PUBLIC_BUCKET=music-shop-previews
S3_PRIVATE_BUCKET=music-shop-originals
SIGNED_URL_EXPIRATION_SECONDS=1800

# Payment Gateway (VietQR / PayOS / SePay)
PAYMENT_GATEWAY_API_URL=https://api-merchant.payos.vn
PAYMENT_CLIENT_ID=your-payment-client-id
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_CHECKSUM_KEY=your-payment-checksum-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret-key

# Email Notification (Nodemailer / Resend / SendGrid)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Music Shop <no-reply@musicshop.vn>"
