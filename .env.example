# ==========================================
# music-shop Environment Variables
# ==========================================

# Application Base URL
# Phase 1 Demo: Free Render URL (e.g. https://music-shop-demo.onrender.com)
# Local development: http://localhost:3000
# Phase 2 Production: Custom domain on paid VPS (e.g. https://musicshop.vn)
APP_BASE_URL=https://music-shop-demo.onrender.com

# Database Connection (PostgreSQL)
# DATABASE_URL: Pooled connection string used by the Next.js application runtime.
# On Neon Free tier, use the pooled connection endpoint (with -pooler and pgbouncer=true).
# Local development: postgresql://postgres:postgres@127.0.0.1:5432/music_shop_db?schema=public
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct Database Connection for Prisma Migrations
# DIRECT_URL: Direct unpooled connection string used by Prisma CLI for migrations and schema introspection.
# Prisma CLI migrations require a direct connection because PgBouncer in transaction mode does not support advisory locks.
# On Neon Free tier, use the direct endpoint (without -pooler).
# Local development: postgresql://postgres:postgres@127.0.0.1:5432/music_shop_db?schema=public
DIRECT_URL="postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require"

# External Lossless Masters Directory (Outside repository)
MASTERS_DIR=/absolute/path/to/masters

# Object Storage (Cloudflare R2 / AWS S3)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PUBLIC_BUCKET=music-shop-previews
S3_PRIVATE_BUCKET=music-shop-originals
SIGNED_URL_EXPIRATION_SECONDS=1800

# Email Delivery (Resend)
# RESEND_API_KEY: API key generated from the Resend console.
RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM: On Resend's free tier without a verified custom domain, emails MUST be sent from onboarding@resend.dev.
EMAIL_FROM=onboarding@resend.dev
# OWNER_NOTIFICATION_EMAIL: When using onboarding@resend.dev, Resend strictly restricts outbound delivery
# to the account owner's registration email address. OWNER_NOTIFICATION_EMAIL must equal that exact email address.
OWNER_NOTIFICATION_EMAIL=owner@yourdomain.com
